{
  "name": "catane-frontiers",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:soak": "tsx scripts/soak.ts",
    "check": "npm run build && npm test && npm run test:e2e",
    "format": "prettier --write src tests e2e scripts *.ts *.json",
    "format:check": "prettier --check src tests e2e scripts *.ts *.json",
    "test:stress": "tsx scripts/stress.ts",
    "docs": "tsx scripts/sync-rules.ts",
    "test:http": "tsx scripts/http-check.ts",
    "docs:pdf": "node scripts/render-pdf.mjs"
  },
  "dependencies": {
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
